# Allowlist: ignore everything, then publish only the site's own files.
# To publish a new asset, add a "!/filename" line here on purpose.
/*
!/.gitignore
!/README.md
!/CNAME
!/index.html
!/logo.png
!/favicon.png
!/workshop.jpg
!/404.html
!/robots.txt
!/sitemap.xml
!/assets/
!/archetypes/
!/doshas/
!/work-with-us/
!/workshops/
!/about/
!/contact/
